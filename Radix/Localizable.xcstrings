    "Checking for changes in %@" : {
      "comment" : "Progress title while Radix prepares an incremental rescan.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Änderungen in %@ werden geprüft" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Comprobando si hay cambios en %@" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Recherche de modifications dans %@" } },
