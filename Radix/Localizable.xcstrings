    "Hover over segments to inspect them. Double-click a folder segment or table row to drill down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegen Sie den Zeiger über Segmente, um sie zu untersuchen. Doppelklicken Sie auf ein Ordnersegment oder eine Tabellenzeile, um tiefer zu navigieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa el puntero sobre los segmentos para inspeccionarlos. Haz doble clic en un segmento de carpeta o una fila de la tabla para profundizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Survolez les segments pour les inspecter. Double-cliquez sur un segment de dossier ou une ligne du tableau pour explorer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa il mouse sui segmenti per ispezionarli. Fai doppio clic su un segmento di cartella o su una riga della tabella per esplorare in dettaglio."
          }
        },
        "zh-Hans" : {
