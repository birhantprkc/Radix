    "1. Open Privacy & Security > Full Disk Access.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Abre Privacidad y seguridad > Acceso total al disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Ouvrez Confidentialité et sécurité > Accès complet au disque."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 打开“隐私与安全性”>“完全磁盘访问权限”。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Öffnen Sie „Datenschutz & Sicherheit“ > „Festplattenvollzugriff“."
          }
        }
      }
    },
    "2. Turn on Radix.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Activa Radix."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Activez Radix."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 打开 Radix。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Aktivieren Sie Radix."
          }
        }
      }
    },
    "3. Choose Quit & Reopen when macOS asks.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Elige Salir y volver a abrir cuando macOS lo solicite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Choisissez Quitter et rouvrir lorsque macOS vous le demande."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. macOS 提示时选择“退出并重新打开”。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Wählen Sie „Beenden & erneut öffnen“, wenn macOS Sie dazu auffordert."
          }
        }
      }
    },
    "A duplicate filesystem path was collapsed in the scan results.": {
      "comment": "Warning shown when duplicate filesystem paths are collapsed.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se consolidó una ruta del sistema de archivos duplicada en los resultados del análisis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chemin de système de fichiers en double a été regroupé dans les résultats de l’analyse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描结果中已合并重复的文件系统路径。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein doppelter Dateisystempfad wurde in den Scan-Ergebnissen zusammengeführt."
          }
        }
      }
    },
    "Access": {
      "localizations": {
        "es": {
