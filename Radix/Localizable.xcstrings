    "Archive section compression could not be initialized." : {
      "comment" : "Archive error detail when the system compression stream cannot be initialized.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Komprimierung des Archivabschnitts konnte nicht initialisiert werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo inicializar la compresión de la sección del archivo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La compression de la section d’archive n’a pas pu être initialisée." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Impossibile inizializzare la compressione della sezione dell’archivio." } },
