    "Forensic comparison only: scan coverage or settings differ, so totals may not be directly comparable." : {
      "comment" : "Comparison coverage message when scan totals should not be compared directly.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur forensischer Vergleich: Scan-Abdeckung oder Einstellungen unterscheiden sich, daher sind die Summen möglicherweise nicht direkt vergleichbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo comparación forense: la cobertura o los ajustes del análisis difieren, por lo que los totales no son directamente comparables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparaison médico-légale uniquement : la couverture ou les réglages diffèrent, les totaux peuvent donc ne pas être directement comparables."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo confronto forense: la copertura o le impostazioni di scansione differiscono, quindi i totali potrebbero non essere direttamente confrontabili."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅供取证比较：扫描覆盖范围或设置不同，因此总计可能无法直接比较。"
          }
        }
      }
    },
