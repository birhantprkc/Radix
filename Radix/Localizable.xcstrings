        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在检查 %@ 中的更改" } }
      }
    },
    "Complete rescan finished" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Vollständiger erneuter Scan abgeschlossen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Nuevo análisis completo finalizado" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Nouvelle analyse complète terminée" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Nuova scansione completa terminata" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完整重新扫描已完成" } }
      }
    },
    "Disk rescans need a complete scan to keep storage totals accurate." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Erneute Festplattenscans benötigen einen vollständigen Scan, damit die Speicherwerte korrekt bleiben." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Volver a analizar un disco requiere un análisis completo para mantener exactos los totales de almacenamiento." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La nouvelle analyse d’un disque nécessite une analyse complète pour conserver des totaux de stockage exacts." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "La nuova scansione di un disco richiede una scansione completa per mantenere accurati i totali di archiviazione." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重新扫描磁盘需要完整扫描，以确保储存空间总量准确。" } }
      }
    },
    "No changes since the previous scan" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine Änderungen seit dem vorherigen Scan" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No hay cambios desde el análisis anterior" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucune modification depuis l’analyse précédente" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Nessuna modifica dalla scansione precedente" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自上次扫描以来没有更改" } }
      }
    },
    "Radix couldn’t safely apply the recent changes." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Radix konnte die letzten Änderungen nicht sicher übernehmen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Radix no pudo aplicar de forma segura los cambios recientes." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Radix n’a pas pu appliquer les modifications récentes en toute sécurité." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Radix non ha potuto applicare in modo sicuro le modifiche recenti." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Radix 无法安全地应用最近的更改。" } }
      }
    },
    "Radix is scanning the entire location to ensure accurate results." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Radix scannt den gesamten Speicherort, um genaue Ergebnisse zu gewährleisten." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Radix está analizando toda la ubicación para garantizar resultados precisos." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Radix analyse l’emplacement entier afin de garantir des résultats exacts." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Radix sta analizzando l’intera posizione per garantire risultati accurati." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Radix 正在扫描整个位置，以确保结果准确。" } }
      }
    },
    "Why a complete scan?" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Warum ein vollständiger Scan?" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Por qué un análisis completo?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pourquoi une analyse complète ?" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Perché una scansione completa?" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "为什么要进行完整扫描？" } }
      }
    },
    "Why Radix is performing a complete scan" : {
