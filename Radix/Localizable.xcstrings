        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix 扫描快照完整性检查失败：%@"
          }
        }
      }
    },
    "Radix scanned this package as a single item. To zoom into it, turn on “Treat app bundles and packages as folders” in Settings, then rescan this location." : {
      "comment" : "Error explaining how to enable package expansion before zooming into a package.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix hat dieses Paket als einzelnes Element gescannt. Aktivieren Sie in den Systemeinstellungen „App-Bundles und Pakete als Ordner behandeln“ und scannen Sie diesen Standort erneut, um den Inhalt zu vergrößern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix analizó este paquete como un único elemento. Para acercarte, activa «Tratar paquetes y aplicaciones como carpetas» en Ajustes y vuelve a analizar esta ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix a analysé ce paquet comme un seul élément. Pour zoomer dessus, activez « Traiter les apps et paquets comme des dossiers » dans Réglages, puis réanalysez cet emplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix ha scansionato questo pacchetto come un singolo elemento. Per ingrandirlo, attiva “Gestisci bundle di app e pacchetti come cartelle” nelle Impostazioni, quindi esegui nuovamente la scansione di questa posizione."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix 将此软件包作为单个项目扫描。若要缩放查看，请在“设置”中打开“将应用和软件包视为文件夹”，然后重新扫描此位置。"
          }
        }
      }
    },
    "Radix scanned this package before package contents were expanded. Rescan this location to zoom into it." : {
      "comment" : "Error shown when a package needs to be rescanned after enabling package expansion.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix hat dieses Paket gescannt, bevor sein Inhalt erweitert wurde. Scannen Sie diesen Standort erneut, um den Inhalt zu vergrößern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix analizó este paquete antes de expandir su contenido. Vuelve a analizar esta ubicación para acercarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix a analysé ce paquet avant d’en développer le contenu. Réanalysez cet emplacement pour zoomer dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix ha scansionato questo pacchetto prima che il contenuto del pacchetto venisse espanso. Esegui nuovamente la scansione di questa posizione per ingrandirlo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix 在展开软件包内容前扫描了此软件包。请重新扫描此位置以缩放查看。"
          }
        }
      }
    },
    "Radix will ask macOS to move %@ to the Trash." : {
      "comment" : "Confirmation message for moving one selected item to the Trash.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix wird macOS auffordern, %@ in den Papierkorb zu bewegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix pedirá a macOS que mueva %@ a la papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix demandera à macOS de placer %@ dans la corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix chiederà a macOS di spostare %@ nel Cestino."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix 将请求 macOS 将 %@ 移到废纸篓。"
          }
        }
      }
    },
    "Radix will ask macOS to move %lld selected items to the Trash:\n%@%@" : {
      "comment" : "Confirmation message listing multiple selected items that will be moved to the Trash.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix wird macOS auffordern, die %lld ausgewählten Elemente in den Papierkorb zu bewegen:\n%@%@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Radix will ask macOS to move %1$lld selected items to the Trash:\n%2$@%3$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix pedirá a macOS que mueva %lld elementos seleccionados a la papelera:\n%@%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix demandera à macOS de placer %lld éléments sélectionnés dans la corbeille :\n%@%@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix chiederà a macOS di spostare %1$lld elementi selezionati nel Cestino:\n%2$@%3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix 将请求 macOS 将 %lld 个所选项目移到废纸篓：\n%@%@"
          }
        }
      }
    },
    "Radix will not move the protected location at %@ to the Trash." : {
      "comment" : "Safety error shown when a protected scan root is selected for deletion.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix wird den geschützten Standort unter %@ nicht in den Papierkorb bewegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix no moverá la ubicación protegida de %@ a la papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix ne placera pas l’emplacement protégé de %@ dans la corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix non sposterà la posizione protetta in %@ nel Cestino."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radix 不会将 %@ 处的受保护位置移到废纸篓。"
          }
        }
      }
