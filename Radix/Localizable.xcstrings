    "Select a segment to inspect it. Double-click a folder segment to zoom in.": {
      "comment": "Accessibility hint for the sunburst chart.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un segmento para inspeccionarlo. Haz doble clic en un segmento de carpeta para acercarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un segment pour l’inspecter. Double-cliquez sur un segment de dossier pour zoomer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
