        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix 目前无法比较快照。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix kann Snapshots derzeit nicht vergleichen."
          }
