    },
    "snapshot section byte counts are incomplete or invalid" : {
      "comment" : "Archive integrity error detail when v5 section byte counts are missing or invalid.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Byteanzahlen der Snapshot-Abschnitte sind unvollständig oder ungültig" } },
