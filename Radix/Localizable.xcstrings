    "Scan folders and disks to see where space is going. Radix stays read-only until you choose a file action." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannen Sie Ordner und Datenträger, um zu sehen, wohin der Speicherplatz geht. Radix bleibt schreibgeschützt, bis Sie eine Dateiaktion auswählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza carpetas y discos para ver dónde se utiliza el espacio. Radix permanece en modo de solo lectura hasta que eliges una acción de archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysez les dossiers et les disques pour voir où va l’espace. Radix reste en lecture seule jusqu’à ce que vous choisissiez une action sur un fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scansiona cartelle e dischi per vedere come viene utilizzato lo spazio. Radix rimane in sola lettura finché non scegli un'azione per i file."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫描文件夹和磁盘以查看空间使用情况。在你选择文件操作前，Radix 始终保持只读。"
          }
        }
      }
    },
