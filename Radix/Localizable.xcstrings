    "Estimated storage that macOS reports as used but that Radix could not attribute to a regular file path." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschätzter Speicherplatz, den macOS als belegt meldet, den Radix jedoch keinem regulären Dateipfad zuordnen konnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almacenamiento estimado que macOS informa como usado pero que Radix no pudo atribuir a una ruta de archivo normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espace estimé que macOS indique comme utilisé, mais que Radix n’a pas pu attribuer à un chemin de fichier standard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio stimato che macOS segnala come utilizzato, ma che Radix non ha potuto attribuire a un percorso di file standard."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 报告为已用但 Radix 无法归因到普通文件路径的估计存储空间。"
          }
        }
      }
    },
