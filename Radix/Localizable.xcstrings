        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix konnte die Topologie des Scan-Snapshots nicht lesen: %@"
          }
        }
      }
    },
    "Radix could not start the FSEvents history stream.": {
      "comment": "Error shown when an FSEvents history stream cannot be started.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix no pudo iniciar el flujo del historial de FSEvents."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix n’a pas pu démarrer le flux d’historique FSEvents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix 无法启动 FSEvents 历史记录流。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix konnte den FSEvents-Verlaufsstream nicht starten."
          }
        }
      }
    },
    "Radix could not verify Full Disk Access on this Mac. You can still scan ordinary folders.": {
      "comment": "Onboarding status shown when Full Disk Access cannot be determined.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix no pudo verificar el Acceso total al disco en este Mac. Aún puedes analizar carpetas normales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix n’a pas pu vérifier l’accès complet au disque sur ce Mac. Vous pouvez toujours analyser les dossiers ordinaires."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix 无法验证这台 Mac 的完全磁盘访问权限。你仍可扫描普通文件夹。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix konnte den Festplattenvollzugriff auf diesem Mac nicht überprüfen. Sie können weiterhin gewöhnliche Ordner scannen."
          }
        }
      }
    },
    "Radix could not verify the current identity for %@: %@": {
      "comment": "Safety error shown when the current file identity cannot be verified.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Radix could not verify the current identity for %1$@: %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix no pudo verificar la identidad actual de %@: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix n’a pas pu vérifier l’identité actuelle de %@ : %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix 无法验证 %@ 的当前身份：%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix konnte die aktuelle Identität für %@ nicht überprüfen: %@"
          }
        }
      }
    },
    "Radix could not verify the scanned identity for %@. Rescan before moving it to Trash.": {
      "comment": "Safety error shown when a scanned file identity cannot be verified.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix no pudo verificar la identidad analizada de %@. Vuelve a analizarlo antes de moverlo a la papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix n’a pas pu vérifier l’identité analysée de %@. Réanalysez-le avant de le placer dans la corbeille."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix 无法验证 %@ 的扫描身份。移到废纸篓前请重新扫描。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix konnte die Identität des Scans für %@ nicht überprüfen. Scannen Sie erneut, bevor Sie das Element in den Papierkorb bewegen."
          }
        }
      }
    },
    "Radix does not currently have Full Disk Access. Normal scans still work; protected folders may be skipped.": {
      "comment": "Onboarding status shown when Full Disk Access is not granted.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix no tiene Acceso total al disco. Los análisis normales siguen funcionando; es posible que se omitan las carpetas protegidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix ne dispose pas actuellement de l’accès complet au disque. Les analyses normales fonctionnent toujours ; les dossiers protégés peuvent être ignorés."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix 当前没有完全磁盘访问权限。普通扫描仍可运行，但可能跳过受保护的文件夹。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix verfügt derzeit nicht über den Festplattenvollzugriff. Normale Scans funktionieren weiterhin; geschützte Ordner werden möglicherweise übersprungen."
          }
        }
      }
    },
    "Radix scan snapshot integrity check failed: %@": {
      "comment": "Error shown when an imported snapshot fails its integrity check.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación de integridad de la instantánea de Radix falló: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification d’intégrité de l’instantané Radix a échoué : %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix 扫描快照完整性检查失败：%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Integritätsprüfung des Radix-Scan-Snapshots ist fehlgeschlagen: %@"
          }
        }
      }
    },
    "Radix scanned this package as a single item. To zoom into it, turn on “Treat app bundles and packages as folders” in Settings, then rescan this location.": {
      "comment": "Error explaining how to enable package expansion before zooming into a package.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix analizó este paquete como un único elemento. Para acercarte, activa «Tratar paquetes y aplicaciones como carpetas» en Ajustes y vuelve a analizar esta ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix a analysé ce paquet comme un seul élément. Pour zoomer dessus, activez « Traiter les apps et paquets comme des dossiers » dans Réglages, puis réanalysez cet emplacement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix 将此软件包作为单个项目扫描。若要缩放查看，请在“设置”中打开“将应用和软件包视为文件夹”，然后重新扫描此位置。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix hat dieses Paket als einzelnes Element gescannt. Aktivieren Sie in den Systemeinstellungen „App-Bundles und Pakete als Ordner behandeln“ und scannen Sie diesen Standort erneut, um den Inhalt zu vergrößern."
          }
        }
      }
    },
    "Radix scanned this package before package contents were expanded. Rescan this location to zoom into it.": {
      "comment": "Error shown when a package needs to be rescanned after enabling package expansion.",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix analizó este paquete antes de expandir su contenido. Vuelve a analizar esta ubicación para acercarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix a analysé ce paquet avant d’en développer le contenu. Réanalysez cet emplacement pour zoomer dessus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix 在展开软件包内容前扫描了此软件包。请重新扫描此位置以缩放查看。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Radix hat dieses Paket gescannt, bevor sein Inhalt erweitert wurde. Scannen Sie diesen Standort erneut, um den Inhalt zu vergrößern."
          }
        }
      }
    },
    "Radix will ask macOS to move %@ to the Trash.": {
