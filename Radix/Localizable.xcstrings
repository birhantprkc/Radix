    "Hidden files are included by default. Mounted volume scans always include them automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verborgene Dateien werden standardmäßig eingeschlossen. Scans eingebundener Volumes schließen sie immer automatisch ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos ocultos se incluyen por defecto. Los análisis de volúmenes montados siempre los incluyen automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
