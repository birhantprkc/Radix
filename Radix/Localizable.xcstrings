    "%@ checksum mismatch" : {
      "comment" : "Archive integrity error detail. The placeholder names the section whose decoded checksum did not match.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Prüfsumme von %@ stimmt nicht überein" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La suma de comprobación de %@ no coincide" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La somme de contrôle de %@ ne correspond pas" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il checksum di %@ non corrisponde" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 校验和不匹配" } }
      }
    },
    "%@ section is missing or unreadable" : {
      "comment" : "Archive integrity error detail. The placeholder names a package section that could not be read.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Abschnitt %@ fehlt oder ist nicht lesbar" } },
